#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=1
#SBATCH --job-name=Verify_Dataset
#SBATCH --ntasks=1
#SBATCH --time=20:00:00
#SBATCH --mem=122000M
#SBATCH --output=outfiles/verify_dataset_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1

export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"

source activate octo-onnx


export NVRTC_LIB_DIR=$(python - <<'PY'
import os,inspect
import nvidia.cuda_nvrtc as nvrtc
print(os.path.join(os.path.dirname(inspect.getfile(nvrtc)),'lib'))
PY
)
export LD_LIBRARY_PATH="$NVRTC_LIB_DIR:$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
[ -f "$NVRTC_LIB_DIR/libnvrtc.so" ] || ln -sf $(ls "$NVRTC_LIB_DIR"/libnvrtc.so.* | head -n1) "$NVRTC_LIB_DIR/libnvrtc.so"


export PYTHONPATH="/gpfs/home4/pkarageorgis/geo_octo:$PYTHONPATH"

srun -u python /gpfs/home4/pkarageorgis/geo_octo/octo/scripts/verify_dataset.py \
  --original_data_dir=/home/pkarageorgis/geo_octo/libero_datasets \
  --vggt_data_dir=/scratch-shared/tmp.cwkV8vOvfY/libero_vggt_onnx_compressed_torch_ae \
  --ae_path=/scratch-shared/tmp.cwkV8vOvfY/libero_vggt_onnx_compressed_torch_ae/vggt_autoencoder_24L_256x512.pt \
  --dataset_name=libero_spatial_no_noops \
  --vggt_agg_layers=24 \
  --vggt_input_res=518 \
  --vggt_dataset_name=libero_spatial_vggt_compressed_torch