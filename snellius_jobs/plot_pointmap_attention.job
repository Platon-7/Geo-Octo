#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=1
#SBATCH --job-name=Plot_Attention_Snapshot
#SBATCH --ntasks=1
#SBATCH --time=00:20:00
#SBATCH --mem=122000M
#SBATCH --output=outfiles/plot_attention_snapshot_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1


export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"


source activate octo-libero-eval

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(realpath "${SCRIPT_DIR}/..")"
cd "${REPO_ROOT}"

export CUDA_NVCC_BIN=$(python -c "import os,inspect,nvidia.cuda_nvcc as nvcc; print(os.path.join(os.path.dirname(inspect.getfile(nvcc)),'bin'))")
export NVRTC_LIB_DIR=$(python -c "import os,inspect,nvidia.cuda_nvrtc as nvrtc; print(os.path.join(os.path.dirname(inspect.getfile(nvrtc)),'lib'))")
export PATH="$CUDA_NVCC_BIN:$PATH"
export LD_LIBRARY_PATH="$NVRTC_LIB_DIR:$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
export PYTHONPATH="${REPO_ROOT}:${REPO_ROOT}/LIBERO:${REPO_ROOT}/octo:${PYTHONPATH}"
export MUJOCO_GL=egl
export TOKENIZERS_PARALLELISM=false
export TF_CPP_MIN_LOG_LEVEL=3
export DISABLE_LIBERO_FLIPS=0

# GPU diagnostics (runs on the allocated GPU node)
srun -n 1 python - <<'PY'
import os, jax, torch
print('CUDA_VISIBLE_DEVICES=', os.environ.get('CUDA_VISIBLE_DEVICES'))
print('JAX:', jax.default_backend(), jax.devices())
print('Torch CUDA:', torch.version.cuda)
PY

export PYTHONPATH="${REPO_ROOT}/vggt:${PYTHONPATH}"

hostname


python evaluation/scripts/plot_pointmap_attention.py \
  --snapshot analysis/attention_snapshots/ketchup_episode3_t1p00s_pointmap.npz \
  --label pointmap \
  --output analysis/attention_snapshots/ketchup_pointmap_readout.png