#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=1
#SBATCH --job-name=Train_VGGT_AE
#SBATCH --ntasks=1
#SBATCH --time=20:00:00
#SBATCH --mem=122000M
#SBATCH --output=outfiles/train_vggt_ae_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1

export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"

source activate octo-onnx

# ===================================================================
# ================= GPU & CUDA DIAGNOSTICS ==========================
# ===================================================================

echo "################################################"
echo "#           STARTING DIAGNOSTICS               #"
echo "################################################"
echo ""

# 1. Check which node the job is running on
echo "--> Running on host: $(hostname)"
echo ""

# 2. Check for NVIDIA drivers using the official utility
echo "--> Checking for NVIDIA driver with nvidia-smi:"
nvidia-smi
echo ""

export NVRTC_LIB_DIR=$(python - <<'PY'
import os,inspect
import nvidia.cuda_nvrtc as nvrtc
print(os.path.join(os.path.dirname(inspect.getfile(nvrtc)),'lib'))
PY
)
export LD_LIBRARY_PATH="$NVRTC_LIB_DIR:$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
[ -f "$NVRTC_LIB_DIR/libnvrtc.so" ] || ln -sf $(ls "$NVRTC_LIB_DIR"/libnvrtc.so.* | head -n1) "$NVRTC_LIB_DIR/libnvrtc.so"

# 3. Check CUDA and Conda environment variables
echo "--> Checking relevant environment variables:"
echo "    - PATH: $PATH"
echo "    - LD_LIBRARY_PATH: $LD_LIBRARY_PATH"
echo "    - CUDA_HOME: $CUDA_HOME"
echo "    - CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "    - CONDA_PREFIX: $CONDA_PREFIX"
echo ""

# 4. Check which python and pip are being used
echo "--> Which python and pip are in the path?"
which python
which pip
echo ""

# 5. List key conda packages
echo "--> Key GPU packages in Conda environment:"
conda list 'pytorch|cudatoolkit|tensorflow|jax|onnxruntime'
echo ""

python -c "import onnxruntime as ort; print(ort.get_available_providers())"

echo "################################################"
echo "#            DIAGNOSTICS COMPLETE              #"
echo "################################################"
echo ""


export PYTHONPATH="/gpfs/home4/pkarageorgis/geo_octo:$PYTHONPATH"

srun -u python /gpfs/home4/pkarageorgis/geo_octo/octo/scripts/train_vggt_ae.py \
  --input_data_dir=/home/pkarageorgis/geo_octo/libero_datasets \
  --output_dir=/home/pkarageorgis/AE_Compressor \
  --dataset_names=libero_spatial_no_noops,libero_goal_no_noops,libero_object_no_noops,libero_10_no_noops \
  --vggt_input_res=224 --use_cuda=True \
  --ae_epochs=25 --ae_lr=1e-4 --ae_hidden=8192 \
  --target_size=256,512 --compression_samples=5000 \
  --batch_size_eval=16 --vggt_agg_layers=24 --vggt_layer_indices=None \
  --use_weighted_layer_fusion=True \
  --use_augmentations=True \
  --ae_verification_enable=True --ae_verification_count=8 \
  --ae_verification_dir=/home/pkarageorgis/AE_Compressor/ae_verification \
  --augmentation_mix_ratio=1.0