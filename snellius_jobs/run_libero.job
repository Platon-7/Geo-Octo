#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1            # Reduced to 1 GPU to avoid DDP issues
#SBATCH --cpus-per-task=9
#SBATCH --gpus=1                # Reduced to 1 GPU to avoid DDP issues
#SBATCH --job-name=Libero_Eval
#SBATCH --ntasks=1
#SBATCH --time=05:30:00         # Increased time for full train-eval-test cycle
#SBATCH --mem=48000M            # Increased memory for more comprehensive analysis
#SBATCH --output=outfiles/libero_evaluation_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1
module load CUDA/11.8.0

export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"

eval "$(conda shell.bash hook)"

source activate octo-libero-eval

export PYTHONPATH=/gpfs/home4/pkarageorgis/geo_octo/LIBERO:$PYTHONPATH

# 2. Now run the srun command. It will inherit the PYTHONPATH we just set.
srun python /gpfs/home4/pkarageorgis/geo_octo/evaluation/scripts/check_libero.py