#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:4              # Request 4 GPUs instead of 1
#SBATCH --cpus-per-task=30        # Scale CPUs (4 GPUs × 7 CPUs)
#SBATCH --gpus=4                 # Request 4 GPUs
#SBATCH --job-name=Octo_Finetune_Offline_MultiGPU
#SBATCH --ntasks=1
#SBATCH --time=48:00:00
#SBATCH --mem=550000M             # Double the memory (or adjust as needed)
#SBATCH --output=outfiles/finetune_offline_octo_multigpu_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1

export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"
export XLA_FLAGS="--xla_gpu_force_compilation_parallelism=1"
export TF_FORCE_GPU_ALLOW_GROWTH=true
export JAX_TRACEBACK_FILTERING=off
export TOKENIZERS_PARALLELISM=false

# Multi-GPU specific settings
# export CUDA_VISIBLE_DEVICES=0,1,2,3

source activate octo
cd octo

srun python scripts/finetune.py \
    --config=scripts/configs/config_offline.py \
    --config.pretrained_path=hf://rail-berkeley/octo-small-1.5 \
    --config.save_dir=./my_octo_vggt_model_offline