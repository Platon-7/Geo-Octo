#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=2
#SBATCH --gpus=1
#SBATCH --job-name=Create_Stats
#SBATCH --ntasks=1
#SBATCH --time=05:30:00
#SBATCH --mem=48000M
#SBATCH --output=outfiles/unified_stats_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1

source activate octo

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
  REPO_ROOT="${SLURM_SUBMIT_DIR}"
else
  SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="$(realpath "${SCRIPT_DIR}/..")"
fi
cd "${REPO_ROOT}/octo"

BASE_DATA_DIR=/scratch-shared/tmp.cwkV8vOvfY/libero_datasets
VGGT_DATA_DIR=/scratch-shared/tmp.cwkV8vOvfY/libero_vggt_onnx_compressed_torch_ae
OUT_DIR="${REPO_ROOT}/libero_datasets/unified_stats"

