# VGGT variants (adjust names if your on-disk dirs differ)
srun -u python scripts/create_unified_statistics.py \
  --base-data-dir $VGGT_DATA_DIR \
  --dataset-names libero_spatial_vggt_compressed_torch \
  --output-dir $OUT_DIR \
  --output-name unified_dataset_statistics_libero_spatial_vggt_compressed_24_torch_ae.json

