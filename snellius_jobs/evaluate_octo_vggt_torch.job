#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=1
#SBATCH --job-name=Evaluate_Octo_VGGT_Torch
#SBATCH --ntasks=1
#SBATCH --time=15:00:00
#SBATCH --mem=122000M
#SBATCH --output=outfiles/evaluate_octo_vggt_torch_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1


export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"


source activate octo-libero-eval

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
  REPO_ROOT="${SLURM_SUBMIT_DIR}"
else
  SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="$(realpath "${SCRIPT_DIR}/..")"
fi
cd "${REPO_ROOT}"
AE_COMPRESSOR_PATH="${REPO_ROOT}/AE_Compressor/vggt_autoencoder_24L_256x512.pt"

export CUDA_NVCC_BIN=$(python -c "import os,inspect,nvidia.cuda_nvcc as nvcc; print(os.path.join(os.path.dirname(inspect.getfile(nvcc)),'bin'))")
export NVRTC_LIB_DIR=$(python -c "import os,inspect,nvidia.cuda_nvrtc as nvrtc; print(os.path.join(os.path.dirname(inspect.getfile(nvrtc)),'lib'))")
export PATH="$CUDA_NVCC_BIN:$PATH"
export LD_LIBRARY_PATH="$NVRTC_LIB_DIR:$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
export PYTHONPATH="${REPO_ROOT}:${REPO_ROOT}/LIBERO:${REPO_ROOT}/octo:${PYTHONPATH}"
export MUJOCO_GL=egl
export TOKENIZERS_PARALLELISM=false
export TF_CPP_MIN_LOG_LEVEL=3
export DISABLE_LIBERO_FLIPS=0

# GPU diagnostics (runs on the allocated GPU node)
srun -n 1 python - <<'PY'
import os, jax, torch
print('CUDA_VISIBLE_DEVICES=', os.environ.get('CUDA_VISIBLE_DEVICES'))
print('JAX:', jax.default_backend(), jax.devices())
print('Torch CUDA:', torch.version.cuda)
PY

export PYTHONPATH="${REPO_ROOT}/vggt:${PYTHONPATH}"

# srun python evaluate_model.py
# experiment_20251102_143753
srun python -m evaluation.scripts.run_libero_eval_vggt_torch \
  --model_family octo \
  --pretrained_checkpoint "/scratch-shared/tmp.cwkV8vOvfY/trained_models/my_octo_vggt_model_online/octo_finetune_vggt/experiment_20251102_143753" \
  --checkpoint_step 200000 \
  --task_suite_name libero_object \
  --num_trials_per_task 10 \
  --num_open_loop_steps 4 \
  --use_vggt_tokens True \
  --vggt_ae_path "${AE_COMPRESSOR_PATH}" \
  --vggt_input_res 224 \
  --vggt_agg_layers 24 \
  --vggt_only_eval True \
  --vggt_layer_indices=None \
  --capture_attention_snapshot True \
  --attention_snapshot_label vggt_only \
  --attention_snapshot_task "pick up the ketchup and place it in the basket" \
  --attention_snapshot_episode_idx 3 \
  --attention_snapshot_seconds 2.0 \
  --attention_snapshot_output_dir "analysis/attention_snapshots" \
  --attention_snapshot_filename "ketchup_episode3_t1p00s_vggt_only.npz"