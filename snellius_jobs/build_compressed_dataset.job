#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1            # Reduced to 1 GPU to avoid DDP issues
#SBATCH --cpus-per-task=4
#SBATCH --gpus=1                # Reduced to 1 GPU to avoid DDP issues
#SBATCH --job-name=Compress_VGGT_Libero
#SBATCH --ntasks=1
#SBATCH --time=06:00:00         # Increased time for full train-eval-test cycle
#SBATCH --mem=122000M            # Decreased memory (we dont need it)
#SBATCH --output=outfiles/build_compressed_dataset_%A.out

module purge
module load 2024
module load Anaconda3/2024.06-1
module load CUDA/11.8.0

export WANDB_API_KEY="5d3260b21e8729601f20bfe817abc713a0dcc047"
export WANDB_ENTITY="nlp-squad"
export WANDB_PROJECT="Geo_Octo"

source activate octo
cd octo

srun -u python scripts/create_vggt_dataset_compressed.py \
    --input_data_dir="/home/pkarageorgis/geo_octo/libero_datasets" \
    --output_data_dir="/scratch-shared/tmp.cwkV8vOvfY/libero_vggt_compressed" \
    --target_size="32,48" \
    --compression_samples=2500 \
    --vggt_batch_size=32 \
    --overwrite